# ---------------------------------------------------------------------------
# ESSEMBLE backend configuration
# Copy to .env and fill in. Every key here maps to a field in app/core/config.py
# ---------------------------------------------------------------------------

# PostgreSQL DSN. A plain libpq URL from a managed provider is fine -- the
# scheme is rewritten to +asyncpg and sslmode= is translated to ssl= by
# app/core/config.py, so paste the provider string as-is.
#
# It MUST be the direct endpoint, not a transaction pooler: Neon without
# '-pooler' in the host, Supabase on 5432 rather than 6543. A pooled DSN is
# rejected at startup rather than corrected -- pooling breaks LISTEN/NOTIFY,
# and the SSE seat-map stream would connect and then deliver nothing.
DATABASE_URL=postgresql+asyncpg://essemble:essemble@localhost:5432/essemble

# Database for the test suite -- a SEPARATE database, normally a branch of
# the one above.
#
# This is not a convenience. The suite TRUNCATEs every application table at
# session start, and a deployed instance runs a sweeper and an outbox
# dispatcher against its database permanently. Point both at one database
# and the two destroy each other: the workers mutate rows mid-test, and the
# suite wipes the deployment's data on every run.
#
# tests/conftest.py refuses to start unless this names a different endpoint
# from DATABASE_URL. Must also be a direct (non-pooled) endpoint.
TEST_DATABASE_URL=postgresql+asyncpg://essemble:essemble@localhost:5432/essemble_test

# Public base URL of this API (used later for tokenised links in emails).
APP_BASE_URL=http://localhost:8000

# Echo emitted SQL to stdout. Never enable in production.
DB_ECHO=false

# Open and close a connection per use instead of pooling. The test suite sets
# this: pytest-asyncio can hand each test its own event loop, and a pooled
# asyncpg connection belongs to the loop that opened it. Leave false in any
# real deployment -- it costs a TCP+TLS handshake per statement.
DB_USE_NULL_POOL=false

# SQLAlchemy pool geometry, ignored when DB_USE_NULL_POOL is true. Kept small
# because managed free tiers cap total connections well below the default.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# local | staging | production
ENVIRONMENT=local

# Browser origins allowed to call this API, comma-separated.
#
# NOT settable to "*". The API is served with allow_credentials=True, and the
# CORS spec forbids pairing credentials with a wildcard origin -- a browser
# rejects the response rather than relaxing it. List the real origins: the
# local frontend during development, plus the deployed frontend's URL once it
# exists, e.g.
#   CORS_ORIGINS=http://localhost:3000,https://essemble.vercel.app
CORS_ORIGINS=http://localhost:3000

# --- auth -------------------------------------------------------------------
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# --- booking ----------------------------------------------------------------
HOLD_TTL_SECONDS=600
WAITLIST_OFFER_TTL_SECONDS=900
MAX_SEATS_PER_HOLD=10
CANCELLATION_CUTOFF_MINUTES=60
# HMAC key for QR payloads. A raw booking reference must not be enough to
# check in, so this is a real secret in production.
QR_SECRET=change-me-in-production

# --- scheduling -------------------------------------------------------------
SHOW_BUFFER_MINUTES=30
DEFAULT_EVENT_RUNTIME_MIN=120

# --- workers ----------------------------------------------------------------
SWEEPER_INTERVAL_SECONDS=10
OUTBOX_INTERVAL_SECONDS=5
WORKERS_ENABLED=true
OUTBOX_ENABLED=true

# SSE seat-map fan-out (Postgres LISTEN/NOTIFY). Needs a long-lived process
# and the direct endpoint above; it cannot work on serverless. Turning it off
# leaves the versioned `?since` poll path, which is the supported fallback and
# is never removed -- SSE is an upgrade on it, not the mechanism.
REALTIME_ENABLED=true

# --- mail -------------------------------------------------------------------
# 'console' renders the email to stdout, so the app runs end to end with no
# credentials. 'resend' delivers for real and needs RESEND_API_KEY.
MAIL_DRIVER=console
RESEND_API_KEY=
MAIL_FROM=Essemble <tickets@essemble.dev>
